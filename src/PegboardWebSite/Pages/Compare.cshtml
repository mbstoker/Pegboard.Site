@page "/compare"
@using PegboardWebSite.Services
@{
    Layout = "_LayoutMarketing";
    ViewData["Title"] = "Three AI evaluations of 30 badminton club-night products, scored for a UK social club night";
    ViewData["Description"] = "We ran the same 100-point rubric three times, on two different AI models with different ways of reading the web. ePegboard placed first in all three, scoring between 78.5 and 95.5. Every prompt, every score and everything we got wrong is published here.";
    ViewData["OgTitle"] = "Three evaluations, thirty products, one rubric";

    const string published = "2026-09-09";
    const string canonical = "https://www.epegboard.com/compare";

    // Three runs of the same pre-declared rubric. Sources:
    //   R1 - Marketing/CompetitorAnalysis/ai-comparison-2026-09-09/published-table.md (corrected run 3)
    //   R2 - the Opus 5 High re-run, browser-rendered retrieval, 27 of 30 scored
    //   R3 - the GPT-6 Astra re-run, output-gpt6-astra.md
    // "-" means that run could not read the product's page. It NEVER means zero.
    // Ordered by R2, the run that read the most of the field.
    var rows = new (string Product, string R1, string R2, string R3)[]
    {
        ("ePegboard",            "95.5", "85.5", "78.5"),
        ("ShuttlePilot",         "84.0", "73.0", "59.5"),
        ("Court Buddy",          "-",    "61.0", "-"),
        ("Racket Social",        "79.0", "59.0", "47.5"),
        ("QourtX",               "87.5", "55.5", "47.5"),
        ("ShuttleFlow",          "77.5", "51.5", "50.0"),
        ("Ladderly",             "56.5", "51.0", "45.0"),
        ("Qcourt",               "41.0", "49.0", "42.0"),
        ("ShuttleOps",           "-",    "48.5", "-"),
        ("SmashHQ",              "-",    "-",    "48.0"),
        ("Shuttl",               "63.0", "46.5", "50.0"),
        ("NextFour",             "57.0", "46.0", "40.5"),
        ("PaQueueKa",            "75.0", "46.0", "45.5"),
        ("CourtsFlow",           "-",    "40.5", "-"),
        ("Badminton Peg System", "46.5", "36.0", "44.0"),
        ("vsBadminton",          "71.0", "32.5", "61.5"),
        ("UBR",                  "36.0", "31.0", "33.0"),
        ("Racket Arena",         "-",    "28.0", "-"),
        ("Queue Master",         "-",    "27.5", "-"),
        ("BadBoard",             "74.0", "25.5", "55.0"),
        ("Matchit",              "-",    "23.5", "28.5"),
        ("CourtMaster",          "-",    "20.5", "48.5"),
        ("ServeLeague",          "21.0", "19.0", "61.0"),
        ("SportyHQ",             "-",    "19.0", "-"),
        ("Badmatch",             "17.0", "18.0", "25.0"),
        ("Digital Pegboard",     "29.0", "15.5", "12.5"),
        ("Airchy WebOS",         "38.5", "11.0", "26.5"),
