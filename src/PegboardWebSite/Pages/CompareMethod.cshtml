    ViewData["OgTitle"] = "The evaluation method, in full";

    const string published = "2026-09-09";
    const string canonical = "https://www.epegboard.com/compare/method";

    var criteria = new (int N, string Name, int Weight)[]
    {
        (1,  "Arrival, check-in and late joiners", 6),
        (2,  "Dynamic next-game and court allocation", 12),
        (3,  "Skill-balanced doubles", 12),
        (4,  "Waiting-time and sit-out fairness", 10),
        (5,  "Partner and opponent variety", 8),
        (6,  "Explainability and transparency", 8),
        (7,  "Manual override and special cases", 5),
        (8,  "Player rating system", 7),
        (9,  "Live scoring, statistics and history", 5),
        (10, "Multi-court display and kiosk operation", 5),
        (11, "Attendance and session reporting", 5),
        (12, "Payments and member administration", 5),
        (13, "Competitions, tournaments and league workflows", 4),
        (14, "Resilience and device accessibility", 4),
        (15, "Price and practical limits", 4)
    };

    // The evaluator's own revisions during its self-consistency pass. Ours is first
    // deliberately - it is the one that matters for reading the rest.
    var revisions = new (string Product, string Criterion, string Change, string Why)[]
    {
        ("ePegboard",     "12 Payments",      "full to partial",     "The documentation says plainly that payments are recorded, not processed. It is not a card machine, so a full score conflicted with its own prose."),
        ("QourtX",        "5 Variety",        "full to partial",     "Partner rotation is documented; equivalent detail for opponent variety is not."),
        ("QourtX",        "6 Explainability", "full to partial",     "Rating, fatigue and history are described, but not a user-facing explanation of why an individual match was chosen."),
        ("QourtX",        "7 Manual override","full to partial",     "Preferences and configuration are documented; a comparable manual-override workflow is not."),
        ("QourtX",        "14 Resilience",    "full to partial",     "Native mobile availability is documented; offline operation is not."),
        ("ShuttlePilot",  "10 Kiosk",         "full to partial",     "Laptop multi-round visibility is documented; a kiosk or wallboard workflow is not."),
        ("ShuttlePilot",  "12 Payments",      "full to partial",     "Roles and roster administration are documented; club payment administration is not."),
        ("ShuttlePilot",  "14 Resilience",    "full to partial",     "Phone and browser operation is documented; offline resilience is not."),
        ("Racket Social", "6 Explainability", "full to partial",     "The generated match and ratings are exposed, but not a detailed pick explanation."),
        ("Racket Social", "12 Payments",      "full to unresolved",  "No adequate evidence either way."),
        ("Racket Social", "13 Competitions",  "full to unresolved",  "Tournament functionality is described as beta or under overhaul rather than a completed workflow."),
        ("PaQueueKa",     "13 Competitions",  "partial to absent",   "The site labels tournament management \"coming soon\", so this is verified absent as a current capability rather than merely undocumented."),
        ("BadBoard",      "8 Ratings",        "full to partial",     "A 1-10 player grade is documented, which is not the same as a dynamic performance rating."),
        ("BadBoard",      "10 Kiosk",         "full to partial",     "It requires a Windows laptop or PC."),
        ("eBadders",      "6 Explainability", "full to unresolved",  "No documented selection-explanation mechanism was found."),
        ("eBadders",      "10 Kiosk",         "full to unresolved",  "No sufficient evidence for multi-court display operation."),
        ("eBadders",      "14 Resilience",    "full to unresolved",  "No adequate resilience or device-accessibility evidence."),
        ("eBadders",      "15 Price",         "full to unresolved",  "Pricing and practical limits were not sufficiently documented in the retrieved material."),
        ("vsBadminton",   "7 Manual override","full to partial",     "It can select games and has settings, but a comprehensive manual-override model is not documented."),
        ("vsBadminton",   "15 Price",         "full to unresolved",  "No sufficiently clear current pricing evidence.")
    };

    var retrieval = new (string Product, string Result)[]
    {
        ("Airchy WebOS", "Read"), ("BadBoard", "Read"), ("Badminton Peg System", "Read"),
        ("Badmatch", "Read, but very sparse"),
        ("Court Buddy", "Title only - page built in the browser. Also a pickleball product"),
        ("Court Manager", "Title only - page built in the browser, and the URL used was its app dashboard"),
        ("CourtMaster", "App Store page rate-limited the request (HTTP 429)"),
        ("CourtsFlow", "Title only - page built in the browser. An earlier run read it and scored 59.5"),
        ("Digital Pegboard", "Read"),
        ("eBadders", "Read"), ("ePegboard", "Read"), ("Ladderly", "Read"),
        ("Matchit", "App Store page could not be retrieved"), ("NextFour", "Read"),
        ("PaQueueKa", "Read"), ("Qcourt", "Read"), ("QourtX", "Read"),
        ("QSENPAI", "HTTP 404 - the URL in our records is wrong"),
        ("Queue Master", "Title only - page built in the browser"),
        ("Racket Arena", "Title only - page built in the browser"), ("Racket Social", "Read"),
        ("ServeLeague", "Read"), ("Shuttl", "Read"), ("ShuttleFlow", "Read"),
        ("ShuttleOps", "Title only - page built in the browser"), ("ShuttlePilot", "Read"),
