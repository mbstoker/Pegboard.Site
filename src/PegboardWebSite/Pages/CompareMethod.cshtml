@section Head {
    <script type="application/ld+json">@Html.Raw(articleJsonLd)</script>
}

<section class="page-hero" style="padding:0">
  <div class="wrap">
    <div class="inner">
      <div class="crumb"><a href="/">Home</a> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg> <a href="/compare">Compare</a> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg> <span>Method</span></div>
      <h1 style="margin-top:10px">How it was scored</h1>
      <p class="lede">The rubric was written before anything was looked at. This page is all of it: the fifteen criteria and their weights, the evidence rules, every score the evaluator revised while running, what we corrected afterwards, and the raw output with nothing taken out.</p>
