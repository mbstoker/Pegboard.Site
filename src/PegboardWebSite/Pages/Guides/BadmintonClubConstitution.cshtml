@using PegboardWebSite.Services
@{
    Layout = "_LayoutMarketing";
    ViewData["Title"] = "Writing a badminton club constitution: which template to start from, and what to change";
    ViewData["Description"] = "Do not write one from scratch. Governing bodies publish free badminton templates that are better than anything you would draft - but every one we read has a winding-up clause that fails HMRC's test for community amateur sports clubs.";
    ViewData["OgTitle"] = "Badminton club constitution: which template, and what to fix";

    const string published = "2026-08-26";
    const string canonical = "https://www.epegboard.com/guides/badminton-club-constitution";

    // QUESTION SET (production step 1) - each is an H2 below:
    //  1 Who is actually asking for it?
    //  2 What does it legally have to contain?
    //  3 Which template should you start from?
    //  4 Which clauses do clubs get wrong?
    //  5 What happens to the money if the club folds?
    //  6 Ours is from 1994 - is it still all right?
    //  7 Does having one protect me personally?
    //  8 Do we have to register it anywhere?
    //  9 What about CASC or charity status?
    // 10 Do we need a solicitor?

    var faqPairs = new (string Q, string A)[]
    {
        ("How long should a constitution be?",
         "Shorter than most clubs make them. The published ones we read run from two pages to eight, and the long ones are mostly procedural detail that would sit better in bye-laws. A rule of thumb: if changing it would require an AGM and you can imagine wanting to change it within a year, it should not be in the constitution."),
        ("What are bye-laws, and do we need them?",
         "They are the club's operational rules, sitting under the constitution and changeable by the committee without calling a general meeting. Joining procedures, session times, the guest policy. Guidance for clubs recommends them precisely so that everyday changes do not need a members' vote, and most badminton clubs would benefit from splitting their document this way."),
        ("Can members vote by email or online?",
         "Only if your constitution allows it, and most older ones do not because they predate the question. If you are revising anyway, this is a cheap clause to add and it makes every future vote easier."),
        ("Do we need a quorum, and what should it be?",
         "Yes, or a handful of people can bind the whole club. Set it low enough that you can actually reach it: a quorum you routinely miss is worse than a modest one, because it stops you making decisions at all."),
        ("Who owns the club's equipment?",
         "The members collectively, in an unincorporated association, which is why the winding-up clause matters. If your club owns anything of value, that clause decides where it goes and it is worth getting right before it is needed rather than after."),
        ("Does the constitution need to be signed?",
         "Not usually. What matters is that it was adopted at a properly convened meeting and that the minutes record it, because the minutes are what a bank will ask to see alongside the document itself.")
    };

    var articleJsonLd = GuideSchema.Article(
        "Writing a badminton club constitution: which template to start from, and what to change",
        "Do not write one from scratch. But every free badminton template we read has a winding-up clause that fails HMRC's CASC test.",
        canonical, published);
}

@section Head {
    <script type="application/ld+json">@Html.Raw(articleJsonLd)</script>
}
