@page "/guides/badminton-club-night-formats-compared"
@using PegboardWebSite.Services
@{
    Layout = "_LayoutMarketing";
    ViewData["Title"] = "Badminton club night formats compared: what each system optimises";
    ViewData["Description"] = "Winner-stays-on, round robin, queue rotation and balanced live picking solve different problems. Compare court-time fairness, flexibility, competition, admin and game quality before choosing how to run your badminton night.";
    ViewData["OgTitle"] = "Which badminton club-night format fits your club?";

    const string published = "2026-07-05";   // first publication - held deliberately; GuideSchema
                                             // ties dateModified to it (#396), so advancing it
                                             // would claim this page is new. Revised 2026-08-26.
    const string canonical = "https://www.epegboard.com/guides/badminton-club-night-formats-compared";

    var faqPairs = new (string Q, string A)[]
    {
        ("Is winner-stays-on unfair?",
         "It deliberately rewards winning with more court time, so it is not court-time neutral. That can be exactly the point in a competitive king-of-the-court drill. It is a poor default if your social club promises broadly equal playing opportunities, especially when standards vary."),
        ("Is a round robin suitable for a normal club night?",
         "Usually only when attendance is fixed. Round robins are excellent for a planned event because fixtures and rests can be distributed in advance. Ordinary club nights have late arrivals, early departures and changing numbers, which make a fixed draw awkward."),
        ("What is the simplest format to run?",
         "A basic queue or pegboard is usually simplest: players come off court, join the back and the next eligible group goes on. It handles changing attendance well. Its weakness is that game quality and partner variety depend on how the four players are chosen."),
        ("What is the best format for a mixed-ability social club?",
         "Usually a live rotation that treats waiting time as a fairness constraint while also considering player standard and recent partners. The exact balance depends on the club: some prioritise strict queue order, some game quality, and some player choice."),
        ("Can a club use more than one format?",
         "Yes. A social night can use normal rotation most weeks, king of the court for a short competitive session, and a round robin for an internal event. The format should follow the purpose of the session.")
    };

    var articleJsonLd = GuideSchema.Article(
        "Badminton club night formats compared: what each system optimises",
        "Winner-stays-on, round robin, queue rotation and balanced live picking solve different problems. Compare court-time fairness, flexibility, competition, admin and game quality before choosing how to run your badminton night.",
        canonical, published);
    var faqJsonLd = GuideSchema.Faq(faqPairs);
}

@section Head {
    <script type="application/ld+json">@Html.Raw(articleJsonLd)</script>
    <script type="application/ld+json">@Html.Raw(faqJsonLd)</script>
}

