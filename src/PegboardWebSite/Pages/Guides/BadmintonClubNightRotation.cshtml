@page "/guides/badminton-club-night-rotation"
@using PegboardWebSite.Services
@{
    Layout = "_LayoutMarketing";
    ViewData["Title"] = "Badminton club-night rotation: what fair actually means";
    ViewData["Description"] = "Fair rotation is not simply first-in-first-out. Learn how to balance waiting time, court-time share, game quality, partner variety and late arrivals - and where pegboards, organisers and software each work best.";
    ViewData["OgTitle"] = "How to make badminton club-night rotation feel fair";

    const string published = "2026-07-01";   // first publication - held deliberately; GuideSchema
                                             // ties dateModified to it (#396), so advancing it
                                             // would claim this page is new. Revised 2026-08-26.
    const string canonical = "https://www.epegboard.com/guides/badminton-club-night-rotation";

    var faqPairs = new (string Q, string A)[]
    {
        ("What is the fairest way to rotate badminton players?",
         "Start with opportunity to play: nobody who has been available for the same period should accumulate substantially less court time without a reason. Then use game balance, partner variety and sensible rest as secondary constraints. A strict queue is transparent but can create poor games; pure balancing can make waits hard to understand."),
        ("Should a late arrival go to the back of the queue?",
         "They should not receive credit for waiting before they arrived, but neither should sign-in order become permanent. Once present, measure the opportunity they have actually received. After other players complete another game, a late arrival may quite properly become one of the most underplayed people in the room."),
        ("Is equal games played the same as fair court time?",
         "No. Someone present for two hours and someone present for forty minutes should not necessarily finish on the same game count. Compare play and waiting against the time each player was available."),
        ("Is a physical pegboard still a good system?",
         "Yes, especially for a small or settled group. It is visible, robust and easy to understand. Its limitation is memory: the board knows queue position but not automatically who has repeatedly partnered whom, how uneven recent games were or how much court time each player has received."),
        ("When should a club use rotation software?",
         "When the rules you want to follow exceed what the organiser or physical board can track comfortably. That point depends more on complexity - mixed levels, variable attendance, partner variety and fairness requirements - than on a magic number of players or courts.")
    };

    var articleJsonLd = GuideSchema.Article(
        "Badminton club-night rotation: what fair actually means",
        "Fair rotation is not simply first-in-first-out. Learn how to balance waiting time, court-time share, game quality, partner variety and late arrivals - and where pegboards, organisers and software each work best.",
        canonical, published);
    var faqJsonLd = GuideSchema.Faq(faqPairs);
}

@section Head {
    <script type="application/ld+json">@Html.Raw(articleJsonLd)</script>
    <script type="application/ld+json">@Html.Raw(faqJsonLd)</script>
}

