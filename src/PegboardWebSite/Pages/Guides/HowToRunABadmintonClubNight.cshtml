@page "/guides/how-to-run-a-badminton-club-night"
@using PegboardWebSite.Services
@{
    Layout = "_LayoutMarketing";
    ViewData["Title"] = "How to run a badminton club night: the operating system behind a good session";
    ViewData["Description"] = "A practical organiser's guide to running a badminton club night from check-in to final court: capacity, arrivals, rotation, game quality, changeovers, newcomers, exceptions, payments and the end-of-night review.";
    ViewData["OgTitle"] = "How to run a badminton club night well";

    const string published = "2026-07-01";   // first publication - held deliberately; GuideSchema
                                             // ties dateModified to it (#396), so advancing it
                                             // would claim this page is new. Revised 2026-08-26.
    const string canonical = "https://www.epegboard.com/guides/how-to-run-a-badminton-club-night";

    var faqPairs = new (string Q, string A)[]
    {
        ("How many players should a badminton club have per court?",
         "There is no single ideal number, but the maths is simple: four players can be on a doubles court at once. Six players per court gives a theoretical average playing share of 67%; eight gives 50%, before changeovers. Decide what amount of waiting your club is comfortable with rather than relying on a universal ratio."),
        ("What should an organiser do when a court becomes free?",
         "Ideally almost nothing. The next four should already be known or prepared, so the finishing players leave, the score is recorded and the next game starts. Long decision-making after a court empties wastes the one resource the club has already paid for."),
        ("How should newcomers be handled?",
         "Explain the session in under a minute, estimate their standard without making it an audition, and get them into an appropriate game early. Mix them with established players over the night rather than isolating all newcomers together or throwing them into unsuitable games for the sake of inclusion."),
        ("Should club nights record scores?",
         "Only if the club gets value from the data. Scores are useful for ratings, recaps and competition/team evidence, but score entry should not delay court turnover. A club that does not use results afterwards can legitimately keep the session simpler."),
        ("Do you need an organiser on duty all night?",
         "Someone needs authority for exceptions, but the routine should not require one person to make every decision. A clear pegboard process, shared kiosk or software can let players handle normal check-ins, scores and court changes while an organiser deals only with unusual cases.")
    };

    var articleJsonLd = GuideSchema.Article(
        "How to run a badminton club night: the operating system behind a good session",
        "A practical organiser's guide to running a badminton club night from check-in to final court: capacity, arrivals, rotation, game quality, changeovers, newcomers, exceptions, payments and the end-of-night review.",
        canonical, published);
    var faqJsonLd = GuideSchema.Faq(faqPairs);
}

@section Head {
    <script type="application/ld+json">@Html.Raw(articleJsonLd)</script>
    <script type="application/ld+json">@Html.Raw(faqJsonLd)</script>
}

