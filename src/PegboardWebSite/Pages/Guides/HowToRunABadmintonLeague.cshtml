@page "/guides/how-to-run-a-local-badminton-league"
@using PegboardWebSite.Services
@{
    Layout = "_LayoutMarketing";
    ViewData["Title"] = "How to run a local badminton league: write the awkward rules before you need them";
    ViewData["Description"] = "A practical guide to running an inter-club badminton league: divisions, formats, player eligibility, fixtures, postponements, incomplete teams, results, disputes, promotion and the awkward cases that decide whether clubs trust the competition.";
    ViewData["OgTitle"] = "How to run a local badminton league";

    const string published = "2026-07-05";   // first publication - held deliberately; GuideSchema
                                             // ties dateModified to it (#396), so advancing it
                                             // would claim this page is new. Revised 2026-08-26.
    const string canonical = "https://www.epegboard.com/guides/how-to-run-a-local-badminton-league";

    var faqPairs = new (string Q, string A)[]
    {
        ("How many teams should a badminton league division contain?",
         "There is no universal ideal. The right size follows from the season window and how many matches teams can host. In a double round robin, N teams each play 2(N−1) matches, so 6 teams means 10 matches each, 8 means 14 and 10 means 18. Choose the division size from calendar capacity rather than a rule of thumb."),
        ("Should every team play home and away?",
         "It is common and gives symmetrical home/away opportunity, but it doubles the fixture count. A new or short-season league can legitimately start with a single round robin or central venues. Decide which constraint matters more: symmetry, travel, venue availability or season length."),
        ("How do you stop clubs putting strong players into lower teams?",
         "Write an eligibility system before the season. Existing English leagues use methods such as nominated players, team orders and limits on how many times a player can play up before becoming tied to a higher team. The precise rule matters less than being objective, auditable and difficult to exploit."),
        ("What happens if a team withdraws halfway through?",
         "The rules must say whether completed results stand, are expunged or are converted in some other way. Expunging all results is mathematically clean because teams have then faced the same opponent set, but it can erase legitimate wins. Whatever policy you choose, publish it before the season."),
        ("What is the most important job of a league secretary?",
         "Maintaining a single trusted state of the competition: registered teams and players, agreed fixtures, validated results, table, outstanding disputes and rule decisions. If clubs keep different versions of those facts, every later decision becomes harder.")
    };

    var articleJsonLd = GuideSchema.Article(
        "How to run a local badminton league: write the awkward rules before you need them",
        "A practical guide to running an inter-club badminton league: divisions, formats, player eligibility, fixtures, postponements, incomplete teams, results, disputes, promotion and the awkward cases that decide whether clubs trust the competition.",
        canonical, published);
    var faqJsonLd = GuideSchema.Faq(faqPairs);
}

@section Head {
    <script type="application/ld+json">@Html.Raw(articleJsonLd)</script>
    <script type="application/ld+json">@Html.Raw(faqJsonLd)</script>
}

