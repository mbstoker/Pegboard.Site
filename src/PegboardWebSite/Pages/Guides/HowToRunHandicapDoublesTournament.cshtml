@page "/guides/how-to-run-handicap-doubles-tournament"
@using PegboardWebSite.Services
@{
    Layout = "_LayoutMarketing";
    ViewData["Title"] = "How to run a handicap doubles tournament: make the handicap earn players' trust";
    ViewData["Description"] = "A practical badminton handicap tournament guide: pairing players, converting ratings into head starts, validating the handicap scale, choosing groups and knockouts, calculating court time, handling substitutions and freezing handicaps fairly.";
    ViewData["OgTitle"] = "How to run a badminton handicap doubles tournament";

    const string published = "2026-07-01";   // first publication - held deliberately; GuideSchema
                                             // ties dateModified to it (#396), so advancing it
                                             // would claim this page is new. Revised 2026-08-26.
    const string canonical = "https://www.epegboard.com/guides/how-to-run-handicap-doubles-tournament";

    var faqPairs = new (string Q, string A)[]
    {
        ("What is a badminton handicap tournament?",
         "It is a competition where the weaker side receives an advantage - commonly a points head start - intended to reduce the effect of the known difference in standard. The handicap does not guarantee a 50/50 match; it gives the weaker side a more credible chance while still requiring both pairs to perform."),
        ("How do you calculate the handicap?",
         "Start from a player or pair-strength estimate, then use a published mapping from strength gap to head start. The mapping itself needs calibration from actual handicap results: if stronger pairs still win far more than half the time in a given gap band, the handicap is too weak there; if weaker pairs dominate, it is too strong."),
        ("Should ratings change during the tournament?",
         "Your normal rating system may continue recording results, but the handicaps for a one-day event should normally be based on a snapshot taken before play and stay fixed. Otherwise Match 1 can change Match 2's starting score and two pairs with the same pre-event standard can receive different treatment solely because of schedule order."),
        ("What if a substitute replaces one member of a pair?",
         "The pair-strength estimate has changed, so the original handicap may no longer be defensible. Decide before the event whether substitutions are forbidden, allowed only before a pair's first match, or allowed for injury with the pair re-rated. Knockout substitutions need especially careful rules."),
        ("How can we tell whether our handicaps are fair?",
         "Do not judge from one upset. Pool results across events and group them by pre-handicap strength gap. Look at stronger-side win rate and average finishing margin in each band. A system intended to produce roughly even contests should not leave one side dominating consistently.")
    };

    var articleJsonLd = GuideSchema.Article(
        "How to run a handicap doubles tournament: make the handicap earn players' trust",
        "A practical badminton handicap tournament guide: pairing players, converting ratings into head starts, validating the handicap scale, choosing groups and knockouts, calculating court time, handling substitutions and freezing handicaps fairly.",
        canonical, published);
    var faqJsonLd = GuideSchema.Faq(faqPairs);
}

@section Head {
    <script type="application/ld+json">@Html.Raw(articleJsonLd)</script>
    <script type="application/ld+json">@Html.Raw(faqJsonLd)</script>
}

