@page "/guides"
@using System.Linq
@{
    Layout = "_LayoutMarketing";
    ViewData["Title"] = "Guides for running a badminton club, and playing in one";
    ViewData["Description"] = "Practical guides for badminton clubs: running the session, keeping court time fair, ratings and team selection, competitions and leagues, and playing better doubles.";
    ViewData["OgTitle"] = "Guides for running a badminton club, and playing in one";

    // Guide cards - order is deliberate: the broad pillar first, then rotation, then the rest.
    var guides = new (string Group, string Url, string Eyebrow, string Title, string Blurb)[]
    {
        ("night", "/guides/how-to-run-a-badminton-club-night", "Checklist", "Running a badminton club night: the complete organiser's checklist", "The full checklist, from booking the hall to locking up: what to sort beforehand, how to run a fair and full session, and what to tidy up after."),
        ("night", "/guides/rolling-out-epegboard-to-your-club", "Adoption", "How to roll out ePegboard to your club", "The before / on-the-night / after playbook one club used to switch over and get more than twenty players onto their own accounts in two sessions."),
        ("night", "/guides/badminton-club-night-rotation", "Club nights", "How to run fair player rotation on a club night", "How clubs manage who plays next - the pegboard queue, an organiser making games, or software - and how to keep court time fair as your numbers grow."),
        ("night", "/guides/managing-club-night-rotation", "Comparison", "Pegboard, organiser or app: how to manage club-night rotation", "The real ways badminton clubs manage who plays next - pegboard queue, organiser-made games, players sorting themselves, or an app - compared, and how to pick one."),
        ("night", "/guides/fair-court-time-busy-club-night", "Fairness", "How to give everyone fair court time on a busy night", "Uneven court time is the number-one club-night complaint. What fair court time actually means, why it slips, and how to keep everyone's share even."),
        ("night", "/guides/game-variety-stop-same-players", "Variety", "Stop the same four playing together every week", "Why the same players always pair up, why it quietly pushes newcomers away, and how to spread partners and opponents around."),
        ("compete", "/guides/badminton-club-rating-systems", "Ratings", "How club rating systems work, and why they beat A/B/C grades", "A plain-English guide to how player ratings work, how they differ from A/B/C grades, and why they make for fairer games, handicaps and teams."),
        ("compete", "/guides/picking-league-teams-club-data", "League", "Picking balanced league teams from your club-night data", "How to move from selecting teams on gut feel to picking them on real evidence: which pairings work, and how to balance across divisions."),
        ("compete", "/guides/how-to-run-handicap-doubles-tournament", "Competitions", "How to run a handicap doubles tournament", "A step-by-step guide to running a tournament where players of every standard can compete: formats, handicaps, scoring, and doing it without spreadsheets."),
        ("night", "/guides/best-badminton-club-night-software", "Buyer's guide", "Best badminton club-night software: what to look for", "A practical buyer's guide: the features that actually matter, what to check before you commit, and how to tell a real fit from a feature list."),
        ("night", "/guides/paper-pegboard-to-app", "Modernising", "From paper pegboard to app: modernising club sessions", "What the traditional pegboard does well, where it struggles, what an app adds, and how to move across without losing your club's history."),
        ("night", "/guides/mixed-ability-badminton-club-night", "Mixed ability", "Keeping beginners and advanced players both happy", "How to give everyone balanced, competitive games across a wide ability spread, without sorting players onto level-based courts."),
        ("compete", "/guides/how-to-run-a-badminton-round-robin", "Round robin", "How to run a badminton round robin", "Everyone plays everyone, fairly: drawing the fixture, handling odd numbers and sit-outs, and sustaining that fairness week to week."),
        ("night", "/guides/how-to-start-a-badminton-club", "Getting started", "How to start a badminton club", "The practical operator's guide: venue, players, kit and fees, your first sessions, and running the night fairly from day one."),
        ("night", "/guides/badminton-club-night-formats-compared", "Comparison", "Club night formats compared: winner-stays-on vs round-robin vs fair rotation", "An honest comparison of the three main formats, when to use each, and where automated fair rotation beats winner-stays-on."),
        ("compete", "/guides/how-to-run-a-local-badminton-league", "Leagues", "How to run a local inter-club badminton league", "The league secretary's how-to: divisions, fixtures, results and promotion and relegation, plus using play-based data to seed divisions and pick teams."),
        ("play", "/guides/badminton-doubles-positioning", "Doubles", "Badminton doubles positioning: where to stand, and when to move", "Two shapes, decided by who can hit down next. How to switch between them, which side to take when you are suddenly forced to defend, and why defending is not a straight line."),
        ("play", "/guides/how-to-choose-a-badminton-racket", "Equipment", "How to choose a badminton racket: 3 specs that matter, and what to ignore", "We counted all 228 adult rackets in Badminton HQ's catalogue. Only sixteen matched the club default we recommend; thirteen of those cost under £80, and none above £180 matched at all."),
        ("club", "/guides/badminton-court-hire", "Venue", "Negotiating court hire with a leisure centre", "We surveyed what UK venues actually charge and what they will move on. The median is £13.45 an hour, the range is wide, and the discount you can ask for is usually not the one advertised."),
        ("club", "/guides/setting-club-subs", "Money", "Setting club subs: what to charge", "There is no average sub, because clubs sell two different products. We probed 923 club websites: only 16% state a price at all."),
        ("club", "/guides/collecting-club-subs", "Money", "Collecting club subs: how to actually get paid", "At 60 members paying £50, the entire fee difference between the cheapest and dearest way to collect is under £90 a year. Billing frequency is what costs you evenings."),
        ("club", "/guides/badminton-club-insurance", "Insurance", "Badminton club insurance: what affiliation covers, and what it does not", "Affiliating insures the club, not the players. Badminton England publishes the same benefits table on two pages and the two disagree about exactly that."),
        ("club", "/guides/badminton-club-constitution", "Governance", "Writing a badminton club constitution: which template, and what to change", "Do not write one from scratch. Every free badminton template we read has a winding-up clause that would fail HMRC's test for community amateur sports clubs."),
        ("club", "/guides/badminton-club-committee-roles", "Governance", "Which committee roles does a badminton club have to fill?", "The law requires none of them. The bank is what forces the classic three, and from September 2026 every affiliated club also needs a trained welfare officer."),
        ("play", "/guides/badminton-service-rules", "Rules", "The service rules club players get wrong", "BWF publishes two service-height laws at once, on purpose. In English tournaments the waist rule is the default and the 1.15 metre height is what a tournament opts into."),
        ("club", "/guides/feather-vs-nylon-shuttlecocks", "Equipment", "Feather vs nylon: what should your club buy?", "Tube prices mislead because nylon comes in sixes and feather in twelves. Per shuttle the ranges overlap, and the real cost depends on how each wears in play."),
        ("play", "/guides/best-badminton-rackets-club-players", "Equipment", "Best badminton rackets for club players: what £40 to £100 actually buys", "The band is two markets with a seam at £80. The tier suffix carries the spec, not the model name: the same Astrox 99 is £72 and £224."),
        ("play", "/guides/badminton-footwork-split-step", "Footwork", "Badminton footwork: the split step and the six corners", "The split step is a landing, not a jump, and its timing is set by your opponent's contact rather than your own count."),
        ("play", "/guides/how-to-smash-harder", "Technique", "How to smash harder, and why it is not your wrist", "Across 18 skilled players, wrist flexion range of movement had no measurable relationship with shuttle speed. The wrist flexor is the second-to-last muscle to fire."),
        ("play", "/guides/first-badminton-club-night", "New players", "Your first badminton club night: what to expect", "What actually happens, what to bring, what it costs, and what nobody tells you about walking into a hall where everyone already knows each other.")
    };

    // Groups are the domains of club life the estate covers. They grow as it does;
    // a thin group is an honest signal of where we are, not a gap to hide.
    var groups = new (string Key, string Heading, string Intro)[]
    {
        ("night", "Running your club night", "The session itself: who plays next, keeping court time even, and giving a wide range of standards a good game."),
        ("club", "Running the club", "The organisation around the night: the venue deal, what to charge and how to collect it, and the governance a club needs once it is handling other people's money."),
        ("compete", "Competitions and teams", "Leagues, tournaments and selection, and the ratings that make all three fairer."),
        ("play", "Playing better", "For the people on court rather than the person running the night. This is where the estate is growing next.")
    };
}

<!-- HERO -->
<section class="page-hero" style="padding:0">
  <div class="wrap">
    <div class="inner">
      <div class="crumb"><a href="/">Home</a> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg> <span>Guides</span></div>
      <h1 style="margin-top:10px">Guides for running a badminton club, and playing in one</h1>
      <p class="lede">Practical, no-nonsense guides on the things clubs actually wrestle with, and on the things that decide whether you get a good game when you get there. Written by the people building ePegboard.</p>
    </div>
  </div>
</section>

<!-- GUIDES GRID -->
<section style="padding-top:44px">
  <div class="wrap">
    @foreach (var grp in groups)
    {
      var inGroup = guides.Where(x => x.Group == grp.Key).ToArray();
      <h2 id="@grp.Key" style="margin:0 0 6px;font-size:1.45rem">@grp.Heading</h2>
      <p style="color:var(--muted-2);max-width:60ch;margin:0 0 24px">@grp.Intro</p>
      <div class="hub-grid" style="margin-bottom:54px">
        @foreach (var g in inGroup)
        {
          <a class="feat-card" href="@g.Url">
            <div class="feat-body">
              <div class="step-eyebrow">@g.Eyebrow</div>
              <h4>@g.Title</h4>
              <p>@g.Blurb</p>
              <span class="feat-learn">Read the guide <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
            </div>
          </a>
        }
      </div>
    }
  </div>
</section>

<!-- CTA -->
<section class="cta" style="margin-top:44px">
  <div class="wrap">
    <h2>Run your club on ePegboard, free</h2>
    <p>Everything in these guides, built in. No subscription. No card details.</p>
    <div class="cta-actions">
      <a class="btn btn-ghost btn-lg" style="background:#fff" href="https://play.epegboard.com/signup" target="_blank" rel="noopener">Sign up</a>
      <a class="btn btn-lg cta-demo" href="https://play.epegboard.com/instant-demo" target="_blank" rel="noopener">See it in action</a>
    </div>
  </div>
</section>
