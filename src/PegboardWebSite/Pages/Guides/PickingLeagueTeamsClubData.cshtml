    ViewData["Description"] = "How a badminton captain can pick league pairs from club-night results rather than reputation: what the evidence shows, how many games make it trustworthy, a worked selection, and when the data should not decide.";
    ViewData["OgTitle"] = "Picking league teams from club-night results";

    const string published = "2026-07-01";   // FIRST publication - never advance it.
    const string modified = "2026-11-02";    // last substantive revision (ado:2397); keep the
                                             // sitemap lastmod in step.
    const string canonical = "https://www.epegboard.com/guides/picking-league-teams-club-data";

    // Boundary questions only (Operating/articles.md template row 13): adjacent to the page
    // question, deliberately outside it, one to three sentences each.
    var faqPairs = new (string Q, string A)[]
    {
        ("Should the captain or a committee pick the team?",
         "Either works if the club says which in advance and the same rules apply all season. What causes trouble is a selection that is sometimes the captain's and sometimes a committee's, depending on who complains."),
        ("Does a club-night rating carry over to league matches?",
         "Only roughly. A club rating measures players against each other inside your club, so it ranks your squad well and says little about the pair you will face on Thursday."),
        ("What about singles?",
         "Most club nights are doubles, so they produce little singles evidence. Pick singles players on singles results, or on the captain's judgement where there are none."),
        ("Can level doubles results tell you about mixed pairs?",
         "Partly. Individual standard carries over; a partnership's record does not, because a mixed pair plays a different game and needs its own results together."),
        ("How often should a captain reselect?",
         "Look at the evidence every few weeks, not after every match. One bad night against a strong team is a result, not a trend.")
    };

    var articleJsonLd = GuideSchema.Article(
        "Picking badminton league teams from club-night results",
        "How a badminton captain can pick league pairs from club-night results rather than reputation: what the evidence shows, how many games make it trustworthy, a worked selection, and when the data should not decide.",
        canonical, published, modified);
    // No FAQPage JSON-LD (Operating/articles.md item 19): the FAQ stays visible text only.
}

@section Head {
    <script type="application/ld+json">@Html.Raw(articleJsonLd)</script>
}

