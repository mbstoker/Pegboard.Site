    ViewData["Description"] = "There is no average badminton sub, because clubs sell two different products. We read the published fees at 25 UK clubs: an all-in season sub sits around £198, a pay-per-session club charges about £50 plus £4 to £8.60, and almost nothing sits in between.";
    ViewData["OgTitle"] = "What UK badminton clubs charge in subs";

    const string published = "2026-08-26";
    const string canonical = "https://www.epegboard.com/guides/setting-club-subs";

