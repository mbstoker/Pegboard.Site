@page "/features/league-team-support"
@{
    Layout = "_LayoutMarketing";
    ViewData["Title"] = "Badminton league team selection";
    ViewData["Description"] = "Pick stronger badminton league teams on real club-night data: partnership analytics, objective player ratings and fixed partnerships - select on evidence, not hunches.";
}

<!-- HERO -->
<section class="page-hero" style="padding:0">
  <div class="wrap">
    <div class="inner">
      <div class="crumb"><a href="/">Home</a> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg> <a href="/features">Features</a> <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg> <span>League Team Support</span></div>
      <h1 style="margin-top:10px">Build stronger league teams</h1>
      <p class="lede">Use real badminton club-night data to find the doubles pairings that actually work - and pick teams on evidence, not hunches.</p>
      <div class="hero-actions">
        <a class="btn btn-primary btn-lg" href="https://play.epegboard.com/signup" target="_blank">Sign up</a>
        <a class="btn btn-ghost btn-lg" href="#how">See how it works</a>
      </div>
      <div class="pill-row">
        <span class="pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Availability and selection</span>
        <span class="pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Partnership analytics</span>
        <span class="pill"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Objective player ratings</span>
      </div>
    </div>
  </div>
</section>

<!-- AVAILABILITY & SELECTION WORKFLOW (SPEC-34) -->
<section class="bg-soft" id="availability">
  <div class="wrap">
    <div class="section-head center">
      <span class="eyebrow">Availability and selection</span>
      <h2>Run your team's matchday admin in one place</h2>
      <p>Stop chasing WhatsApp replies against a spreadsheet. Keep your squad, publish a fixture, send one link for everyone to say if they're free, then pick the team and tell them - all in ePegboard.</p>
    </div>

    <!-- 5-step flow -->
    <div class="flow">
      <div class="node"><b>Keep your squad</b><small>your team's player pool</small></div>
      <span class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      <div class="node"><b>Publish a fixture</b><small>opponent, when, how many</small></div>
      <span class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      <div class="node"><b>Send one link</b><small>into your WhatsApp group</small></div>
      <span class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      <div class="node"><b>Pick the team</b><small>players and subs</small></div>
      <span class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      <div class="node"><b>Tell everyone</b><small>email and in-app</small></div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">

    <!-- One link (SPEC-34) -->
    <div class="showcase" style="margin-bottom:64px">
      <div class="copy">
        <div class="step-eyebrow">One link, no chasing</div>
        <h3>Ask the whole squad in one message</h3>
        <p>Publish the fixture and ePegboard gives you a single link with a ready-made message. Drop it into your squad's WhatsApp group - that's the whole job. Replies come in over the week and are counted for you: available, can't make it, or still to answer.</p>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> One link into the group chat you already use</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Replies tallied for you - no spreadsheet</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> A nudge for anyone who hasn't answered</li>
        </ul>
        <div class="callout">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          <p><b>Your squad get their own accounts as they reply.</b> A player without an account yet is signed up by their first reply - tied to their name, rating and history at your club. Nothing to install.</p>
        </div>
      </div>
      <div class="shot">
        <div class="bar"><span class="dots"><i></i><i></i><i></i></span><span class="url">play.epegboard.com/teams</span></div>
        <img src="/img/league-availability.png" alt="The availability view - a count of who is available, who can't make it and who hasn't replied, above the squad list with each player's answer and a nudge for those still to respond">

      </div>
    </div>

    <!-- Pick + notify (SPEC-34) -->
    <div class="showcase flip">
      <div class="copy">
        <div class="step-eyebrow">Pick and notify</div>
        <h3>Pick the team, tell everyone in one go</h3>
        <p>From the players who said they're free, pick your team to the size you need and name your subs - a standby can even be someone yet to reply. Then one action tells the whole selected team where and when they're playing, by email and in their ePegboard fixture view.</p>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Pick to your fixture size, name your subs</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Everyone told at once - email and in-app</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Players see their fixtures and can withdraw</li>
        </ul>
        <a class="feat-learn" href="https://docs.epegboard.com/league-teams/" target="_blank" rel="noopener">Read the League teams guide <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
      </div>
      <div class="shot">
        <img src="/img/league-team-selection.png" alt="The team selection screen - players who said they are available with tick boxes, the team picked toward the required count, and a named standby substitute">

      </div>
    </div>
  </div>
</section>

<!-- FEATURES -->
<section>
  <div class="wrap">

    <!-- Partnership analytics (real) -->
    <div class="showcase" style="margin-bottom:64px">
      <div class="copy">
        <div class="step-eyebrow">Partnership analytics</div>
        <h3>Discover which partnerships actually work</h3>
        <p>Every pairing is measured against what their ratings predicted. See who consistently performs better together - and who only looks good on paper.</p>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> A "vs expected" figure for every pair</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Over-performing or under-performing, at a glance</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Confidence based on games played together</li>
        </ul>
        <div class="callout">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
          <p><b>"Over-performing" means a pair regularly beats what their ratings expect.</b> Those are the partnerships worth keeping together for league nights.</p>
        </div>
      </div>
      <div class="shot">
        <div class="bar"><span class="dots"><i></i><i></i><i></i></span><span class="url">play.epegboard.com/partnerships</span></div>
        <img src="/img/partnerships-card.png" alt="Partnership analytics - pairs ranked by performance versus expectation, a mix of over-performing, as-expected and under-performing, each with a confidence level">
      </div>
    </div>

    <!-- Player ratings (real) -->
    <div class="showcase flip" style="margin-bottom:64px">
      <div class="copy">
        <div class="step-eyebrow">Player ratings</div>
        <h3>Ratings you can trust, from real results</h3>
        <p>Every game updates a player's rating based on how they performed against expectation - not just wins and losses. It is the foundation for fair pairings and balanced teams.</p>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Stronger opponents are worth more</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Narrow defeats hurt less than thrashings</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg> Updates automatically after every game</li>
        </ul>
      </div>
      <div class="shot">
        <div class="bar"><span class="dots"><i></i><i></i><i></i></span><span class="url">play.epegboard.com/members</span></div>
        <img src="/img/ratings.png" alt="A player's rating progression over a season, climbing as results come in">
      </div>
    </div>

    <!-- Fixed partnerships (sticky pairs - real) -->
    <div class="showcase">
      <div class="copy">
        <div class="step-eyebrow">Fixed partnerships</div>
        <h3>Keep proven pairings together</h3>
        <p>Found a pair that clicks? Set them as a sticky pair and ePegboard keeps them together in the fair-share rotation - their games tagged so everyone can see the pairing is locked.</p>
      </div>
      <div class="shot">
        <img src="/img/sticky-pairs.png" alt="Sticky pairs shown as combined chips in the waiting queue, each labelled 'sticky pair - plays together'">
      </div>
    </div>
  </div>
</section>

<!-- HOW IT WORKS FLOW -->
<section class="bg-soft" id="how">
  <div class="wrap">
    <div class="section-head center">
      <span class="eyebrow">How it fits together</span>
      <h2>Every club night makes your team selection smarter</h2>
      <p>The games you already play feed the data that picks better teams - no extra admin.</p>
    </div>
    <div class="flow">
      <div class="node"><b>Club night results</b><small>games you already play</small></div>
      <span class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      <div class="node"><b>Player ratings</b><small>updated every game</small></div>
      <span class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      <div class="node"><b>Partnership analytics</b><small>what works together</small></div>
      <span class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      <div class="node"><b>Fixed partnerships</b><small>keep the best pairs</small></div>
      <span class="arrow"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
      <div class="node"><b>Pick your team</b><small>on real evidence</small></div>
    </div>
  </div>
</section>

<!-- ENGINE THREAD -->
<section style="padding:48px 0">
  <div class="wrap">
    <div class="engine-strip">
      <div class="es-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 17l6-6 4 4 8-8"/><path d="M21 7v6h-6"/></svg></div>
      <div class="es-txt">
        <h3>One rating system, the whole platform</h3>
        <p>Team insights run on the same ratings that pick your club-night games and set tournament handicaps - so everything stays consistent and current.</p>
      </div>
      <a class="btn btn-ghost" style="background:#fff" href="https://docs.epegboard.com/ratings/overview/" target="_blank" rel="noopener">How ratings work</a>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta">
  <div class="wrap">
    <h2>Pick your next team on real data</h2>
    <p>Free for your club. No card details.</p>
    <div class="cta-actions">
      <a class="btn btn-ghost btn-lg" style="background:#fff" href="https://play.epegboard.com/signup" target="_blank">Sign up</a>
      <a class="btn btn-lg cta-demo" href="https://play.epegboard.com/instant-demo" target="_blank" rel="noopener">See it in action</a>
    </div>
    <p class="fine">Tablet or laptop-sized screens recommended for the best experience.</p>
  </div>
</section>

<!-- FOOTER -->
