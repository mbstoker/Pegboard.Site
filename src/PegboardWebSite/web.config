<?xml version="1.0" encoding="utf-8"?>
<!--
  Pegboard.Site web.config — checked into source so it SURVIVES `dotnet publish`.

  The .NET SDK (Microsoft.NET.Sdk.Web) merges this file with the auto-generated
  ANCM config at publish time: it injects the <aspNetCore> in-process handler into
  THIS file rather than overwriting it. That is why the rewrite rules below are safe
  to keep here — the deploy overlay (deploy-vps.ps1) ships the published web.config,
  which now contains BOTH the ANCM handler and the reverse-proxy rules.

  SEAM S6 (ADR-0007 Option A / ADR-0010 FF-S6): www/club/* is edge-routed to the
  PegboardWeb app, which static-SSRs those routes. /, /features, /track/* etc. keep
  serving from this Site. The proxy target is chosen by the inbound host so the SAME
  build works on staging (www.staging -> play.staging) and prod (www/apex -> play).

  PREREQUISITE (server-level, Mike-gated, one-time per box):
    * IIS "URL Rewrite" module installed.
    * IIS "Application Request Routing" (ARR) installed AND its proxy enabled
      (system.webServer/proxy enabled="true" in applicationHost.config).
    Without ARR proxy enabled, an <action type="Rewrite"> to an absolute URL 500s
    ("... this configuration section cannot be used at this path" / rule ignored).
    See deploy/enable-arr-club-proxy.ps1 for the staged install + enable.
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!--
          Route the public club-page corpus to the PegboardWeb app.
          Matches /club, /club/{slug}, /club/{slug}/session/{id}, etc.
          Everything else (/, /features, /track/*, static assets) falls through
          to this Site's ANCM handler untouched.
        -->
        <rule name="ClubCorpusToApp-Staging" stopProcessing="true">
          <match url="^club(/.*)?$" />
          <conditions logicalGrouping="MatchAll">
            <!-- Only rewrite when we are serving the STAGING marketing host. -->
            <add input="{HTTP_HOST}" pattern="^www\.staging\.epegboard\.com$" />
          </conditions>
          <!-- Preserve the full path+query; target the app over loopback http. -->
          <action type="Rewrite" url="http://localhost/{R:0}" appendQueryString="true" />
          <serverVariables>
            <!-- Make ANCM on the target box route to the play.staging site binding. -->
            <set name="HTTP_HOST" value="play.staging.epegboard.com" />
            <!-- Forwarded headers so the app can build correct absolute (www) URLs. -->
            <set name="HTTP_X_FORWARDED_HOST"  value="www.staging.epegboard.com" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>

        <rule name="ClubCorpusToApp-Prod" stopProcessing="true">
          <match url="^club(/.*)?$" />
          <conditions logicalGrouping="MatchAll">
            <!-- Prod marketing hosts: www.epegboard.com and the bare apex. -->
            <add input="{HTTP_HOST}" pattern="^(www\.)?epegboard\.com$" />
          </conditions>
          <action type="Rewrite" url="http://localhost/{R:0}" appendQueryString="true" />
          <serverVariables>
            <set name="HTTP_HOST" value="play.epegboard.com" />
            <set name="HTTP_X_FORWARDED_HOST"  value="www.epegboard.com" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
        </rule>
      </rules>

      <!--
        ARR caches proxied responses per its own defaults. The club/session pages are
        cacheable static-SSR HTML; a short shared TTL cuts app load without going stale
        on same-day recaps. Output-cache profile applied to the proxied responses.
      -->
      <outboundRules>
        <!-- Add a cache hint on proxied club responses (belt-and-braces; the app also
             sets Cache-Control). Rewrites ONLY when the response came via the club rule. -->
        <rule name="ClubProxyCacheHeader" preCondition="IsClubProxied">
          <match serverVariable="RESPONSE_Cache-Control" pattern=".*" />
          <action type="Rewrite" value="public, max-age=300" />
        </rule>
        <preConditions>
          <preCondition name="IsClubProxied">
            <add input="{REQUEST_URI}" pattern="^/club(/.*)?$" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <!--
      Server variables set by rewrite rules must be whitelisted at the site level or
      IIS returns HTTP 500.50 ("... not been added to the allowed server variables").
    -->
    <security>
      <requestFiltering>
        <!-- (kept default; no path exclusions needed) -->
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
